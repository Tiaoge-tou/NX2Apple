From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tiaoge-tou <85100527+Tiaoge-tou@users.noreply.github.com>
Date: Fri, 6 Nov 2026 16:38:24 +0800
Subject: [PATCH] iOS: Game Mode on by default in every build
 (GCSupportsGameMode)

The three iOS project specs carried LSSupportsGameMode but not GCSupportsGameMode. iOS only grants the raised memory tier to apps it classifies as games, and the classification needs both keys in Info.plist; without the GC key the shell and the game apps run in the default memory tier (measured 6655 MB against 8191 MB with Game Mode on). Add GCSupportsGameMode: true beside LSSupportsGameMode in project.yml, project-framework.yml and project-shell.yml, the same line the nxnative fork carries. The Mac packer keeps Game Mode off on purpose (macOS Game Mode pins the GPU at its lowest frequency) and is not touched.

Upstream-Status: fork-only
Reason: Game Mode on by default in every build: the three iOS project specs carry LSSupportsGameMode but not GCSupportsGameMode, and iOS grants the raised memory tier only to apps it classifies as games
Issue: Tiaoge-tou/NX2Apple PROJECT.md Phase 4

---
 dm/ios/project-framework.yml | 1 +
 dm/ios/project-shell.yml     | 1 +
 dm/ios/project.yml           | 1 +
 3 files changed, 3 insertions(+)

diff --git a/dm/ios/project-framework.yml b/dm/ios/project-framework.yml
index 89a2df5..6c210b4 100644
--- a/dm/ios/project-framework.yml
+++ b/dm/ios/project-framework.yml
@@ -53,6 +53,7 @@ targets:
         DMShowFPS: ${DM_SHOW_FPS}           # YES = the frame-rate counter is on (front_ios.m; set by build_ipa.sh)
         DMLanguage: ${DM_LANG}              # the game language code (main.m sets DM_LANG from it; set by build_ipa.sh)
         LSSupportsGameMode: true
+        GCSupportsGameMode: true            # Game Mode on by default in every build: iOS only grants the raised memory tier to apps it classifies as games
         GCSupportsControllerUserInteraction: true   # Physical controllers (GameController)
         GCSupportedGameControllers:
           - ProfileName: ExtendedGamepad
diff --git a/dm/ios/project-shell.yml b/dm/ios/project-shell.yml
index 60fda10..42749da 100644
--- a/dm/ios/project-shell.yml
+++ b/dm/ios/project-shell.yml
@@ -59,6 +59,7 @@ targets:
         LSApplicationCategoryType: public.app-category.games
         DMShowFPS: false
         LSSupportsGameMode: true
+        GCSupportsGameMode: true            # Game Mode on by default in every build: iOS only grants the raised memory tier to apps it classifies as games
         GCSupportsControllerUserInteraction: true
         GCSupportedGameControllers:
           - ProfileName: ExtendedGamepad
diff --git a/dm/ios/project.yml b/dm/ios/project.yml
index 8964dbb..5e05fea 100644
--- a/dm/ios/project.yml
+++ b/dm/ios/project.yml
@@ -50,6 +50,7 @@ targets:
         DMLanguage: ${DM_LANG}              # the game language code (main.m sets DM_LANG from it; set by build_ipa.sh)
         DMForkPatches: ${DM_FORK_PATCHES}   # the fork's patches this build carries (dm/fork_patches.txt, written by scripts/patches.py; set by build_ipa.sh)
         LSSupportsGameMode: true
+        GCSupportsGameMode: true            # Game Mode on by default in every build: iOS only grants the raised memory tier to apps it classifies as games
         GCSupportsControllerUserInteraction: true   # Physical controllers (GameController)
         GCSupportedGameControllers:
           - ProfileName: ExtendedGamepad
