From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tiaoge-tou <85100527+Tiaoge-tou@users.noreply.github.com>
Date: Fri, 6 Nov 2026 07:57:57 +0800
Subject: [PATCH] iOS tests: give the romfs locator fixture the profile name

main.m reads dm_profile()->name for the game-named data folder since the folder change landed, and the fixture profile only carries the id and the romfs marker, so the fixture no longer compiles.

Upstream-Status: fork-only
Reason: The romfs locator fixture predates the game-named folder change and lacks the profile name main.m reads
Issue: Tiaoge-tou/NX2Apple PROJECT.md Phase 4

---
 dm/ios/tests/test_romfs_startup.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/dm/ios/tests/test_romfs_startup.py b/dm/ios/tests/test_romfs_startup.py
index 4792b5e..9c86eca 100644
--- a/dm/ios/tests/test_romfs_startup.py
+++ b/dm/ios/tests/test_romfs_startup.py
@@ -24,7 +24,7 @@ class Startup(unittest.TestCase):
         source = root / 'locator.m'
         source.write_text('#import <Foundation/Foundation.h>\n#include <stdio.h>\n#include "romfs_image.h"\n#include "romfs_identity.h"\n'
                           'static NSString *fixture_doc, *fixture_tmp, *fixture_bundle;\n#define DM_GAME_ROMFS_MARKER "marker"\n'
-                          'typedef struct { const char *id, *romfs_marker; } fixture_profile;   /* the fork reads both from the runtime profile */\nstatic const fixture_profile *dm_profile(void) { static const fixture_profile p = {"0100000000000000", "marker"}; return &p; }\n'
+                          'typedef struct { const char *id, *name, *romfs_marker; } fixture_profile;   /* the fork reads them from the runtime profile */\nstatic const fixture_profile *dm_profile(void) { static const fixture_profile p = {"0100000000000000", "Fixture Game", "marker"}; return &p; }\n'
                           '@interface FixtureBundle : NSObject\n+ (instancetype)mainBundle;\n- (NSString *)resourcePath;\n@end\n'
                           '@implementation FixtureBundle\n+ (instancetype)mainBundle { return [self new]; }\n'
                           '- (NSString *)resourcePath { return fixture_bundle; }\n@end\n#define NSBundle FixtureBundle\n'
