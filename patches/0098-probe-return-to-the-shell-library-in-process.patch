diff --git a/dm/host/hle_thread.c b/dm/host/hle_thread.c
index d623db4..f7b1fd8 100644
--- a/dm/host/hle_thread.c
+++ b/dm/host/hle_thread.c
@@ -338,6 +338,19 @@ static void *thread_main(void *p) {
     dm_thread_enter(t->entry, t->arg, t->stack_top);   // Does not return: the guest must exit through ExitThread
     die("guest thread entry returned");
 }
+// Probe (DM_PROBE_RETURN): freeze the whole guest world in place. Every guest thread's mach port is
+// suspended and never resumed: the threads are abandoned where they stand, with their stacks and any
+// host locks they happen to hold, which is exactly what the probe exists to measure. The caller is a
+// host UI thread, never a guest thread, so no entry in the list is the caller. Suspending under G
+// keeps the list itself stable (thr_free needs G); only mach calls run while G is held.
+void dm_guest_freeze_all(void) {
+    pthread_mutex_lock(&G);
+    int n = 0;
+    for (thr_t *t = g_all; t; t = t->all) if (t->mport) { thread_suspend(t->mport); n++; }
+    pthread_mutex_unlock(&G);
+    LOG("probe: froze %d guest threads in place; they are never resumed", n);
+}
+
 static void thr_free(thr_t *t) {   // Holding G; unlink from the all-threads chain and free
     for (thr_t **p = &g_all; *p; p = &(*p)->all) if (*p == t) { *p = t->all; break; }
     for (thr_t *u = g_all; u; u = u->all)   // no handoff entry may point at the freed object (note_runnable reads the waker's epoch)
