 UIViewController *front_ios_root(void);
 void front_ios_focus_event(int ev);
+void dm_host_shutdown_reset(void);   // Probe (hle_lifecycle.c): re-arm the teardown for the next game
+void dm_profile_reload(void);   // Probe (hle_profile.c): the next game loads its own profile
+
+static int g_started, g_boot_once;   // the once guards of dm_shell_start_game and front_ios_boot, at file scope so the probe's return can re-arm them
 
 static char **g_argv; static int g_argc; static int g_boot_ok;
 
@@ -42,8 +47,7 @@ static void log_to(NSString *log) {
 const char *dm_shell_start_game(const char *const *keys, const char *const *values, int n, const char *const *argv, int argc,
                                 const char *executable, const char *marker, const char *log_path, const char *cwd) {
     static char err[512];
-    static int started;
-    if (started++) return "A game was already started in this session. Close the app and open it again.";
+    if (g_started++) return "A game was already started in this session. Close the app and open it again.";
     if (argc < 2) return "The game's start arguments are incomplete.";
     log_to(@(log_path));
     fprintf(stderr, "shell: starting %s (%s)\n", argv[1], executable);
@@ -90,6 +94,28 @@ void dm_shell_present_game(void) {
                                                 errorHandler:^(NSError *e) { fprintf(stderr, "shell: landscape request: %s\n", e.localizedDescription.UTF8String); }];
 }
 
+// Probe (DM_PROBE_RETURN): front_ios.m froze the guest and ran the teardown without its exit; hand the
+// window back to a fresh library and re-arm every once guard on the start path, so Play can start a
+// game again in this process. The first game's boot thread stays frozen inside dm_main forever, its
+// framework stays loaded (only the image header moves to the next game), and its mappings stay mapped:
+// what that breaks is what the probe measures. Never called in a normal build (the launch plan sets
+// DM_PROBE_RETURN only for probe builds, and the gesture follows it).
+void dm_shell_return_to_library(void) {
+    dm_host_shutdown_reset();
+    dm_host_preload_reset();
+    dm_profile_reload();
+    g_started = 0; g_boot_once = 0; g_boot_ok = 0;
+    UIWindow *window = nil;
+    for (UIScene *s in UIApplication.sharedApplication.connectedScenes)
+        if ([s isKindOfClass:UIWindowScene.class]) for (UIWindow *w in ((UIWindowScene *)s).windows) if (w.isKeyWindow || !window) window = w;
+    if (!window) { fprintf(stderr, "[RED] probe: no window for the library\n"); return; }
+    UIViewController *library = [ShellLibrary makeController];
+    window.rootViewController = library;
+    [library setNeedsUpdateOfSupportedInterfaceOrientations];
+    UIApplication.sharedApplication.idleTimerDisabled = NO;
+    fprintf(stderr, "probe: back at the library; the next Play starts a game in this process\n");
+}
+
 // ---- what front_ios.m takes from main.m and Launcher.swift ----
 static void *boot_thread(void *p) {
     (void)p;
@@ -99,7 +125,7 @@ static void *boot_thread(void *p) {
     return NULL;
 }
 void front_ios_boot(void) {   // front_ios.m, once the game view exists
-    static int once; if (once++ || !g_boot_ok) return;
+    if (g_boot_once++ || !g_boot_ok) return;
     void front_ios_audio_session(void); front_ios_audio_session();
     pthread_attr_t a; pthread_attr_init(&a); pthread_attr_setstacksize(&a, 64u << 20);
     pthread_t t; pthread_create(&t, &a, boot_thread, NULL); pthread_detach(t);
