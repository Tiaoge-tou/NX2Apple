     [a addAction:[UIAlertAction actionWithTitle:zh ? @"取消" : @"Cancel" style:UIAlertActionStyleCancel handler:nil]];
-    [a addAction:[UIAlertAction actionWithTitle:zh ? @"关闭游戏" : @"Close game" style:UIAlertActionStyleDestructive handler:^(UIAlertAction *action) { exit(0); }]];   // the shell opens on its library, so closing the app is the way back to it
+    if (probe) [a addAction:[UIAlertAction actionWithTitle:zh ? @"返回游戏库" : @"Return to library" style:UIAlertActionStyleDestructive handler:^(UIAlertAction *action) {
