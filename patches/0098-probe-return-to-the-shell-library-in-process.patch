diff --git a/dm/host/hle_lifecycle.c b/dm/host/hle_lifecycle.c
index e027970..8dcf21e 100644
--- a/dm/host/hle_lifecycle.c
+++ b/dm/host/hle_lifecycle.c
@@ -7,10 +7,11 @@
 #include <signal.h>
 #include <unistd.h>
 void hlecount_flush(void); void dm_rec_finish(void);
-void dm_host_shutdown(const char *why) {
-    static _Atomic int once; if (atomic_exchange(&once, 1)) return;
+static _Atomic int shutdown_once;
+static void shutdown_impl(const char *why, int exit_after) {
+    if (atomic_exchange(&shutdown_once, 1)) return;
     uint64_t t0 = now_ns(); LOG("received %s: graceful exit", why);
-    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 1500 * NSEC_PER_MSEC), dispatch_get_global_queue(QOS_CLASS_USER_INTERACTIVE, 0), ^{
+    if (exit_after) dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 1500 * NSEC_PER_MSEC), dispatch_get_global_queue(QOS_CLASS_USER_INTERACTIVE, 0), ^{
         LOG("[RED] graceful exit not done in 1.5 seconds, exiting at once"); _exit(0); });
     hlecount_flush();                               // DM_HLECOUNT: _exit does not run atexit, write a copy here
     dm_rec_finish();                                // DM_REC: the held state and the buffered steps (hle_hid.c)
@@ -18,8 +19,15 @@ void dm_host_shutdown(const char *why) {
     dm_audio_suspend(1);
     dm_gfx_suspend(1);
     LOG("graceful exit done (%.3f s)", (now_ns() - t0) / 1e9);
-    _exit(0);
+    if (exit_after) _exit(0);
+    else LOG("probe: teardown done, the process stays alive (no exit)");
 }
+void dm_host_shutdown(const char *why) { shutdown_impl(why, 1); }
+// Probe (DM_PROBE_RETURN): the teardown above without the exit and without the watchdog that forces
+// one, for the shell's in-process return to the library. The guest threads are already frozen, so a
+// graphics drain that cannot finish simply stays unfinished; nothing here may end the process.
+void dm_host_shutdown_return(const char *why) { shutdown_impl(why, 0); }
+void dm_host_shutdown_reset(void) { atomic_store(&shutdown_once, 0); }
 void dm_term_install(void) {
     signal(SIGTERM, SIG_IGN);                       // do not take the default action: hand over to the GCD signal source to wrap up on an ordinary thread
     static dispatch_source_t src;
